# Required: replace this with a unique value before running the application.
SECRET_KEY=replace-with-a-long-random-secret

# Local development defaults to True. Hosted environments should use False.
DEBUG=True

# Optional: required only for AI-assisted suggestions.
OPENAI_API_KEY=

# Optional: OpenAI-compatible API endpoint and model. Leave blank to use OpenAI's default endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Optional: leave blank to use SQLite. Example PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Optional: comma-separated trusted origins, including scheme and hostname.
# Example: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# RENDER_EXTERNAL_HOSTNAME is supplied automatically by Render.
